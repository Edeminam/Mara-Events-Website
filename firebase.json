{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "dist/**",
      "**/.DS_Store",
      ".git/**",
      ".github/**",
      ".npm-cache/**",
      ".firebase/**",
      ".idea/**",
      ".vscode/**",
      ".claude/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
